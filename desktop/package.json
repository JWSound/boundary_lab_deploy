{
  "name": "boundary-lab-deploy",
  "private": true,
  "version": "0.1.0-rc.2",
  "description": "Interactive array deployment prototype for Boundary Lab speaker packages",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test:viewport": "esbuild tests/viewportModel.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/viewportModel.test.mjs && node node_modules/.tmp/viewportModel.test.mjs",
    "test:viewport-rendering": "electron tests/idleViewport.cjs",
    "test:crosshair": "electron tests/plotCrosshair.cjs",
    "test:pattern": "esbuild tests/patternGround.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/patternGround.test.mjs && node node_modules/.tmp/patternGround.test.mjs",
    "test:analysis": "esbuild tests/analysisCapture.test.ts --bundle --packages=external --jsx=automatic --platform=node --format=esm --outfile=node_modules/.tmp/analysisCapture.test.mjs && node node_modules/.tmp/analysisCapture.test.mjs",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:desktop": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "tsc -b && vite build",
    "test:placement": "esbuild tests/cabinetPlacement.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/cabinetPlacement.test.mjs && node node_modules/.tmp/cabinetPlacement.test.mjs",
    "test:channels": "esbuild tests/channels.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/channels.test.mjs && node node_modules/.tmp/channels.test.mjs",
    "start": "electron . --built",
    "test:package": "node scripts/package-smoke.mjs library/S218BP_LOD.blabsp",
    "test:desktop": "electron . --built --smoke-test",
    "test:level2": "electron . --built --smoke-level2",
    "benchmark:level2": "electron . --built --benchmark-level2",
    "preview": "vite preview --host 127.0.0.1",
    "test:phasor": "esbuild tests/phasor.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/phasor.test.mjs && node node_modules/.tmp/phasor.test.mjs",
    "pack:win": "npm run build && electron-builder --config electron-builder.json --win --x64 --dir --config.forceCodeSigning=false --config.win.signAndEditExecutable=false",
    "dist:win": "npm run build && electron-builder --config electron-builder.json --win --x64",
    "dist:win:unsigned": "npm run build && electron-builder --config electron-builder.json --win --x64 --config.forceCodeSigning=false --config.win.signAndEditExecutable=false",
    "test:runtime": "node --test tests/runtime.test.cjs"
  },
  "dependencies": {
    "@react-three/drei": "9.108.3",
    "@react-three/fiber": "8.16.8",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.166.1"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.166.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "electron": "30.3.1",
    "electron-builder": "26.0.12",
    "typescript": "5.5.4",
    "vite": "5.3.5",
    "wait-on": "7.2.0"
  },
  "author": "Boundary Lab contributors"
}
